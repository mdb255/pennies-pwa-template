# Database Configuration
RUNTIME_DB_URL=postgresql+psycopg://app_svc_user:password@localhost:55432/app_db?options=-csearch_path%3Dapp
MIGRATIONS_DB_URL=postgresql+psycopg://app_db_owner:password@localhost:55432/app_db?options=-csearch_path%3Dapp

# AWS Cognito Configuration (for authentication)
USER_POOL_ID=your_cognito_user_pool_id
APP_CLIENT_ID=your_cognito_app_client_id
AWS_REGION=<{{ aws_region }}>
JWKS_CACHE_TTL=3600

# Application Configuration
APP_ENV=local
APP_DOMAIN=
SESSION_RESUME_COOKIE_NAME=app.session-resume
SESSION_RESUME_COOKIE_TTL=2592000

# CORS Configuration
# Comma-separated list of allowed origins for local development
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# For production, use:
# CORS_ORIGINS=https://myapp.example.com
# APP_ENV=production
# APP_DOMAIN=example.com
