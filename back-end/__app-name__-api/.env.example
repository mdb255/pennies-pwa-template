# Database Configuration
# Local dev sets RUNTIME_DB_URL directly. Deployed, it is left unset and
# RUNTIME_DB_URL_SSM_PATH is set instead (see below) so the credential is fetched from
# SSM on cold start rather than sitting in the Lambda environment.
RUNTIME_DB_URL=postgresql+psycopg://<{{ app_name_snake }}>_svc_user:<{{ app_name_snake }}>_svc_user_pw@localhost:55432/<{{ app_name_snake }}>_db?options=-csearch_path%3Dapp
MIGRATIONS_DB_URL=postgresql+psycopg://<{{ app_name_snake }}>_db_owner:<{{ app_name_snake }}>_db_owner_pw@localhost:55432/<{{ app_name_snake }}>_db?options=-csearch_path%3Dapp

# AWS Cognito Configuration (for authentication)
USER_POOL_ID=your_cognito_user_pool_id
APP_CLIENT_ID=your_cognito_app_client_id
AWS_REGION=<{{ aws_region }}>
JWKS_CACHE_TTL=3600

# Application Configuration
APP_ENV=local
SESSION_RESUME_COOKIE_NAME=app.session-resume
SESSION_RESUME_COOKIE_TTL=2592000

# CORS Configuration
# Comma-separated list of allowed origins. Local dev only — deployed, the api component's
# CORS is configured on its Lambda Function URL (infra/lambda.tf), not here.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Deployed only (set by OpenTofu on the Lambda functions; not used locally) ---
# APP_ENV=prod
# APP_COMPONENT=api            # api | auth — selects which routers create_app() mounts
# RUNTIME_DB_URL_SSM_PATH=/<{{ app_name }}>/prod/RUNTIME_DB_URL
# (RUNTIME_DB_URL itself is left unset in that case)
