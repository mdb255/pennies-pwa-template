        "globals": "^15.14.0",
        "husky": "^9.1.7",
        "jsdom": "^25.0.1",
        "lint-staged": "^15.2.10",
        "storybook": "^8.5.0",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.20.0",
        "vite": "^6.0.11",
        "vite-plugin-pwa": "^0.21.1",
