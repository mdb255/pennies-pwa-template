        "ionicons": "^8.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-redux": "^9.2.0",
        "react-router": "^5.3.4",
        "react-router-dom": "^5.3.4",
        "swiper": "^11.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@playwright/test": "^1.49.1",
        "@storybook/addon-essentials": "^8.5.0",
        "@storybook/react-vite": "^8.5.0",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^6.6.3",
